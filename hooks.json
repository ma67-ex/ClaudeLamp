{
  "PreToolUse": [
    {
      "matcher": "AskUserQuestion",
      "hooks": [
        {
          "type": "command",
          "command": "(~/.claude/scripts/led.py attention >/dev/null 2>&1 &)",
          "timeout": 10,
          "statusMessage": "LED: needs you"
        }
      ]
    }
  ],
  "Notification": [
    {
      "matcher": "permission_prompt",
      "hooks": [
        {
          "type": "command",
          "command": "(~/.claude/scripts/led.py attention >/dev/null 2>&1 &)",
          "timeout": 10,
          "statusMessage": "LED: needs you"
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "(~/.claude/scripts/led.py done <<< \"$(cat)\" >/dev/null 2>&1 &)",
          "timeout": 10,
          "statusMessage": "LED: done"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "(~/.claude/scripts/led.py working >/dev/null 2>&1 &)",
          "timeout": 10,
          "statusMessage": "LED: working"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "(~/.claude/scripts/led.py unattention >/dev/null 2>&1 &)",
          "timeout": 10,
          "statusMessage": "LED: working"
        }
      ]
    }
  ]
}